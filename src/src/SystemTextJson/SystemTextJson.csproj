<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<AutoIncludeUsings>false</AutoIncludeUsings>
		<RootNamespace>ZodSharp</RootNamespace>
		<AssemblyName>Purview.ZodSharp.SystemTextJson</AssemblyName>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Purview.ZodSharp.SystemTextJson</PackageId>
		<Description>A high-performance C# port of Zod schema validation library. Features zero-allocation validation, struct-based rules, fluent API, and source generator support for maximum performance.</Description>
		<PackageTags>zod;validation;schema;json</PackageTags>
	</PropertyGroup>

	<!--
		Trimming and Native AOT. Verified clean under both analyzers.

		The validating JsonConverter resolves a JsonTypeInfo<T> from the serializer options instead of using
		the reflection-based JsonSerializer overloads, so it defers to whatever resolver the host configured
		— a source-generated JsonSerializerContext in a trimmed or AOT application. JSON Schema import and
		export use this package's own source-generated JsonSchemaJsonContext, so they need nothing from the
		consumer. The extension methods come in pairs: a JsonTypeInfo<T> overload that is safe everywhere,
		and a JsonSerializerOptions overload annotated [RequiresUnreferencedCode]/[RequiresDynamicCode] —
		the same shape JsonSerializer itself uses.
	-->
	<PropertyGroup Label="Trimming and Native AOT">
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ZodSharp\ZodSharp.csproj" />
	</ItemGroup>
</Project>

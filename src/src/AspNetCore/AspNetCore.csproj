<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(ZodSharpNetTargetFrameworks)</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsPackable>true</IsPackable>
		<PackageId>ZodSharp.AspNetCore</PackageId>
		<Description>ASP.NET Core ProblemDetails integration for ZodSharp validation results.</Description>
		<PackageTags>zod;validation;aspnetcore;problemdetails</PackageTags>
		<AssemblyName>ZodSharp.AspNetCore</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ZodSharp\ZodSharp.csproj" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>

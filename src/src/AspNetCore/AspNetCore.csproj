<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(PurviewTargetFrameworksAll)</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!--
			Trimming and Native AOT. Verified clean under both analyzers. Graph-based assembly scanning
			(ScanAssemblyGraphs) and validator discovery remain reflective by nature; they are documented as
			the paths a trimmed or AOT host should avoid in favour of explicit registration.
		-->
		<IsAotCompatible>true</IsAotCompatible>
		<IsPackable>true</IsPackable>
		<AssemblyName>Purview.ZodSharp.AspNetCore</AssemblyName>
		<Description>ASP.NET Core ProblemDetails integration for ZodSharp validation results.</Description>
		<PackageTags>zod;validation;aspnetcore;problemdetails</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ZodSharp\ZodSharp.csproj" />
	</ItemGroup>
</Project>

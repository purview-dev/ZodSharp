<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsRoslynComponent>true</IsRoslynComponent>
		<AssemblyName>Purview.ZodSharp.SourceGenerators</AssemblyName>
		<!-- EnforceExtendedAnalyzerRules (RS10xx) and TreatWarningsAsErrors are NOT set here on purpose:
		     Purview.BuildSdk already forces both to true for any IsRoslynComponent project
		     (Sdk.props "Roslyn Component Project Properties"), and Sdk.targets fails the build if
		     either is disabled. Verify with:
		       dotnet msbuild SourceGenerators.csproj -getProperty:EnforceExtendedAnalyzerRules -getProperty:TreatWarningsAsErrors
		     Setting them here again is redundant and invites the false impression that they are optional. -->
		<!--<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>-->
	</PropertyGroup>

	<ItemGroup Label="Analyzer Release Files">
		<AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
		<AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
		<PackageReference Include="Purview.SourceGeneratorFramework" PrivateAssets="all" />
	</ItemGroup>
</Project>

		<ZodSharpSourceGeneratorTargetFramework>netstandard2.0</ZodSharpSourceGeneratorTargetFramework>
		<ZodSharpSourceGeneratorAssembly>$(MSBuildThisFileDirectory)..\$(ZodSharpSourceGeneratorProjectName)\bin\$(Configuration)\$(ZodSharpSourceGeneratorTargetFramework)\$(RootNamespace).$(ZodSharpSourceGeneratorProjectName).dll</ZodSharpSourceGeneratorAssembly>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeZodSharpSourceGenerator</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>-->

	<ItemGroup>
		<!--Include="$(ZodSharpSourceGeneratorProject)"-->
		<ProjectReference
			Include="../SourceGenerators/SourceGenerators.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
	</ItemGroup>

	<!--<Target
		Name="IncludeZodSharpSourceGenerator"
		Condition="'$(TargetFramework)' == '$(DefaultTargetFramework)'"
	>
		<MSBuild
			Projects="$(ZodSharpSourceGeneratorProject)"
			Targets="GetSourceGeneratorAnalyzerFiles"
			Properties="Configuration=$(Configuration);TargetFramework=$(ZodSharpSourceGeneratorTargetFramework)"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_ZodSharpSourceGeneratorFiles" />
		</MSBuild>

		<ItemGroup>
			<TfmSpecificPackageFile
				Include="@(_ZodSharpSourceGeneratorFiles)"
				PackagePath="analyzers/dotnet/cs/"
			/>
		</ItemGroup>
	</Target>-->

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)..\..\..\README.md" Link="Sdk/README.md" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference
			Include="Microsoft.Extensions.DependencyInjection.Abstractions"
			VersionOverride="$(MicrosoftExtensionsDependencyInjectionAbstractionsVersion)"
		/>
	</ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>ZodSharp</PackageId>
		<Description>
			A high-performance C# port of Zod schema validation library.
			Features zero-allocation validation, struct-based rules, fluent API,
			and source generator support for maximum performance.
		</Description>
		<PackageTags>zod;validation;schema</PackageTags>
		<NoWarn>$(NoWarn);NU5118</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<ZodSharpSourceGeneratorProject>$(MSBuildThisFileDirectory)..\SourceGenerators\SourceGenerators.csproj</ZodSharpSourceGeneratorProject>
		<ZodSharpSourceGeneratorTargetFramework>netstandard2.0</ZodSharpSourceGeneratorTargetFramework>
		<ZodSharpSourceGeneratorAssembly>$(MSBuildThisFileDirectory)..\SourceGenerators\bin\$(Configuration)\$(ZodSharpSourceGeneratorTargetFramework)\ZodSharp.SourceGeneration.dll</ZodSharpSourceGeneratorAssembly>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeZodSharpSourceGenerator</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference
			Include="$(ZodSharpSourceGeneratorProject)"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>

		<None
			Include="buildTransitive\ZodSharp.props"
			Pack="true"
			PackagePath="buildTransitive\ZodSharp.props"
			Visible="true"
		/>
	</ItemGroup>

	<Target Name="IncludeZodSharpSourceGenerator">
		<Error
			Condition="!Exists('$(ZodSharpSourceGeneratorAssembly)')"
			Text="The ZodSharp source generator was not found at '$(ZodSharpSourceGeneratorAssembly)'."
		/>

		<MSBuild
			Projects="$(ZodSharpSourceGeneratorProject)"
			Targets="GetSourceGeneratorAnalyzerFiles"
			Properties="Configuration=$(Configuration);TargetFramework=$(ZodSharpSourceGeneratorTargetFramework)"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_ZodSharpSourceGeneratorFiles" />
		</MSBuild>

		<ItemGroup>
			<TfmSpecificPackageFile
				Include="@(_ZodSharpSourceGeneratorFiles)"
				PackagePath="analyzers/dotnet/cs/"
			/>
		</ItemGroup>
	</Target>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)..\..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference
			Include="Microsoft.Extensions.DependencyInjection.Abstractions"
			VersionOverride="$(MicrosoftExtensionsDependencyInjectionAbstractionsVersion)"
		/>
	</ItemGroup>
</Project>

<Project>
	<PropertyGroup>
		<!--
			Supported .NET target frameworks. .NET 8 leaves support in November 2026;
			removing it is a single-line change here.
		-->
		<ZodSharpNetTargetFrameworks>net8.0;net9.0;net10.0</ZodSharpNetTargetFrameworks>
		<TargetFrameworks>$(ZodSharpNetTargetFrameworks)</TargetFrameworks>
		<NamespacePrefix>ZodSharp</NamespacePrefix>
		<!-- Set project-by-project -->
		<IsPackable>false</IsPackable>
		<ExcludePurviewTelemetry>true</ExcludePurviewTelemetry>
		<RepositoryUrl>https://github.com/guinhx/ZodSharp</RepositoryUrl>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1031;CA1510;</NoWarn>
		<!--
			Commit a NuGet lock file per project so the resolved dependency graph is
			reproducible. CI restores in locked mode; regenerate after version bumps
			with a force-evaluate restore.

			See the README.md in the repo root for potential issues with this approach
			and how to resolve them.
		-->
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<Import Sdk="Purview.DotNetProjectSdk" Project="Sdk.props" />

	<PropertyGroup Condition="'$(IsTestProject)' == 'true' OR '$(OutputType)' == 'Exe'">
		<TargetFramework></TargetFramework>
		<TargetFrameworks>$(ZodSharpNetTargetFrameworks)</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IsPackable)' == 'true'">
		<Authors>ZodSharp Contributors</Authors>
		<PackageProjectUrl>https://github.com/guinhx/ZodSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/guinhx/ZodSharp</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
</Project>
